# Copy to .env.local (or export these yourself) before running the agent.
# demo/quickstart.sh generates .env.local's required vars automatically.

# Required — DataHub GMS REST endpoint (set by demo/quickstart.sh).
DATAHUB_GMS_URL=

# Required — DataHub personal access token (set by demo/quickstart.sh).
DATAHUB_GMS_TOKEN=

# Required — enables delapan's write-time resolver (dedup/refine/contradict)
# instead of pure append-only ADD.
DLP_MEMORY__ENABLED=

# Optional — pins delapan's SQLite store to a repo-local file instead of the
# default ~/.delapan/delapan.db. datahub_memory/__main__.py sets this itself
# if unset, so you only need it to point somewhere else.
DELAPAN_DB_PATH=

# Required to reproduce the resolver-backed ADD/NOOP/UPDATE demo flow.
# It can also supply embeddings.
AI_GATEWAY_API_KEY=

# OPENAI_API_KEY= (alternative embeddings key; does not replace the resolver credential)
# ANTHROPIC_API_KEY= (agent auth; not needed if the Claude Code CLI is logged in on this host)

# Optional — overrides the pinned Claude model the agent loop runs on
# (default: claude-sonnet-4-5).
AGENT_MODEL=
